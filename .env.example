NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/nest-groceries-api
ALLOWED_ORIGINS=http://localhost:3000
THROTTLE_TTL=60
THROTTLE_LIMIT=100
OPENAPI_SOURCE_URL=http://127.0.0.1:3000/api/docs-json
OPENAPI_OUTPUT_PATH=openapi/openapi.json
CLIENT_OUTPUT_DIR=../nest-groceries-web/src/api/generated

# Kinde Authentication (required)
KINDE_ISSUER_URL=https://your-tenant.kinde.com
KINDE_AUDIENCE=your-api-audience-or-client-id
KINDE_CLIENT_ID=your-kinde-client-id
KINDE_SITE_URL=http://localhost:3000
KINDE_REDIRECT_URL=http://localhost:3000/callback
KINDE_SECRET=your-kinde-client-secret

