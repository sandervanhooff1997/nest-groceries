NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/nest-groceries-api
# Comma-separated list of origins allowed to call the API. Include the
# Next.js dev origin (the frontend usually runs on 3001 in this project).
ALLOWED_ORIGINS=http://localhost:3001
THROTTLE_TTL=60
THROTTLE_LIMIT=100
OPENAPI_SOURCE_URL=http://127.0.0.1:3000/api/docs-json
OPENAPI_OUTPUT_PATH=openapi/openapi.json
CLIENT_OUTPUT_DIR=../nest-groceries-web/src/api/generated

# Kinde auth: the backend validates bearer tokens issued by your Kinde tenant.
# KINDE_ISSUER_URL must match the `iss` claim of the tokens.
# Either KINDE_AUDIENCE (preferred, matches the `aud` claim when you've set up an
# API in Kinde) or KINDE_CLIENT_ID (the frontend SPA client id) must be set.
KINDE_ISSUER_URL=https://your-tenant.kinde.com
KINDE_AUDIENCE=https://api.your-tenant
KINDE_CLIENT_ID=your-kinde-client-id

