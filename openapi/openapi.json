  "info": {
    "title": "Nest Groceries API",
    "description": "Shopping list management API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "IssueTokenDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "description": "MongoDB user identifier to embed in the token subject",
            "example": "507f1f77bcf86cd799439011"
          },
          "email": {
            "type": "string",
            "example": "alex@example.com"
          },
          "firstName": {
            "type": "string",
            "example": "Alex"
          },
          "lastName": {
            "type": "string",
            "example": "Smith"
          }
        },
        "required": [
          "userId",
          "email",
          "firstName",
          "lastName"
        ]
      },
      "AuthTokenResponseDto": {
        "type": "object",
        "properties": {
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiI1MDdmMWY3N2JjZjg2Y2Q3OTk0MzkwMTEiLCJlbWFpbCI6ImFsZXhAZXhhbXBsZS5jb20iLCJmaXJzdE5hbWUiOiJBbGV4IiwibGFzdE5hbWUiOiJTbWl0aCIsImlhdCI6MTcxMzM1MDAwMCwiZXhwIjoxNzEzMzUzNjAwfQ.example-signature"
          },
          "expiresIn": {
            "type": "string",
            "example": "3600"
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "expiresIn"
        ]
      },
      "GroceryItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Milk"
          },
          "quantity": {
            "type": "number",
            "example": 2
          },
          "unit": {
            "type": "string",
            "example": "Liter",
            "enum": [
              "Piece(s)",
              "Gram",
              "Kilogram",
              "Liter",
              "Milliliter"
            ]
          },
          "purchased": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateShoppingListDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Weekly groceries"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroceryItemDto"
            }
          }
        },
        "required": [
          "name",
          "items"
        ]
      },
      "UpdateGroceryItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Milk"
          },
          "quantity": {
            "type": "number",
            "example": 2
          },
          "unit": {
            "type": "string",
            "example": "Liter",
            "enum": [
              "Piece(s)",
              "Gram",
              "Kilogram",
              "Liter",
              "Milliliter"
            ]
          },
          "purchased": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "UpdateShoppingListDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Weekend groceries"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpdateGroceryItemDto"
            }
          }
        }
      },
      "DuplicateShoppingListDto": {
        "type": "object",
        "properties": {
          "itemIds": {
            "description": "Optional list of item IDs to duplicate. If omitted, all items are duplicated.",
            "example": [
              "507f1f77bcf86cd799439011"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
