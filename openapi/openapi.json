  "info": {
    "title": "Nest Groceries API",
    "description": "Shopping list management API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "GroceryItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Milk"
          },
          "quantity": {
            "type": "number",
            "example": 2
          },
          "unit": {
            "type": "string",
            "example": "Liter",
            "enum": [
              "Piece(s)",
              "Gram",
              "Kilogram",
              "Liter",
              "Milliliter"
            ]
          },
          "purchased": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateShoppingListDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Weekly groceries"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroceryItemDto"
            }
          },
          "isTemplate": {
            "type": "boolean",
            "example": false
          },
          "fromTemplateId": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          }
        },
        "required": [
          "name",
          "items"
        ]
      },
      "UpdateGroceryItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Milk"
          },
          "quantity": {
            "type": "number",
            "example": 2
          },
          "unit": {
            "type": "string",
            "enum": [
              "Piece(s)",
              "Gram",
              "Kilogram",
              "Liter",
              "Milliliter"
            ]
          }
        }
      },
      "UpdateShoppingListDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Weekend groceries"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpdateGroceryItemDto"
            }
          },
          "isTemplate": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "ItemOverrideDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "quantity": {
            "type": "number",
            "example": 2
          },
          "unit": {
            "type": "string",
            "enum": [
              "Piece(s)",
              "Gram",
              "Kilogram",
              "Liter",
              "Milliliter"
            ]
          }
        }
      },
      "DuplicateShoppingListDto": {
        "type": "object",
        "properties": {
          "itemIds": {
            "description": "Optional list of item IDs to duplicate. If omitted, all items are duplicated.",
            "example": [
              "507f1f77bcf86cd799439011"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "itemOverrides": {
            "description": "Per-item quantity/unit overrides applied during duplication.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ItemOverrideDto"
            }
          }
        }
      },
      "ShareShoppingListDto": {
        "type": "object",
        "properties": {}
      },
      "RemoveAccessDto": {
        "type": "object",
        "properties": {}
      },
      "ReorderGroceryItemsDto": {
        "type": "object",
        "properties": {
          "itemIds": {
            "description": "All item IDs in the desired order (must include every item)",
            "example": [
              "64b1f...",
              "64b2a..."
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "itemIds"
        ]
      }
    }
  }
}
