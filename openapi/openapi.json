          "200": {
            "description": "Returns application health status",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "healthy",
                    "timestamp": "zaterdag 18 april 2026 18:35:41",
                    "services": {
                      "database": "ok"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Check application health",
        "tags": [
          "health"
        ]
      }
    },
