    "/api/health": {
      "get": {
        "operationId": "HealthController_checkHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Returns application health status",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "healthy",
                    "timestamp": "vrijdag 24 april 2026 08:02:45",
                    "services": {
                      "database": "ok"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Check application health",
        "tags": [
          "health"
        ]
      }
    },
